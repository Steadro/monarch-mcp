# Copy this file to ".env" and set values as needed.
# ".env" is gitignored and must NEVER be committed.
#
# Everything here is OPTIONAL — the server works with no .env at all.
# This file documents the environment variables the project reads.

# Override where the captured browser-session auth file is stored.
# Default: <repo>/.mm/mm_auth.json  (gitignored; holds your session cookie)
# MONARCH_AUTH_FILE=
